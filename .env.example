# Local settings for the k8s-servant CLI.
# Copy to .env, fill in, then load into your shell:   set -a; source .env; set +a
# In the cluster the same variables come from the Helm chart's ConfigMap.

# Friendly cluster name used in answers, reports and Teams cards.
CLUSTER_NAME=my-cluster

# Model endpoint: Azure AI Foundry (docs/foundry-setup.md, or scripts/setup-foundry.sh),
# or any OpenAI-compatible base URL with a path, e.g. https://api.openai.com/v1 (experimental).
FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com/
FOUNDRY_DEPLOYMENT=k8s-servant
# Foundry: leave empty to authenticate with `az login` (recommended).
# Other OpenAI-compatible endpoints: the API key (required).
FOUNDRY_API_KEY=
# Or a file that contains the key (wins over FOUNDRY_API_KEY).
FOUNDRY_API_KEY_FILE=

# kubernetes-mcp-server. Empty = do not use MCP, kubectl only.
MCP_URL=http://localhost:8080/mcp

# Prometheus / Alertmanager (optional). Locally use a port-forward, e.g.
#   kubectl -n kube-prometheus-stack port-forward svc/kube-prometheus-stack-prometheus 9090
#   kubectl -n kube-prometheus-stack port-forward svc/kube-prometheus-stack-alertmanager 9093
PROMETHEUS_URL=
ALERTMANAGER_URL=

# Memory folder (findings, run history, learned notes). In the cluster: /data.
DATA_DIR=.data

# MS Teams Workflows webhook URL (a credential: never commit it).
TEAMS_WEBHOOK_URL=
# changes (post a check only when something is new or resolved) | always | off
TEAMS_POST_MODE=changes

# Optional tuning (defaults shown).
# FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
# KNOWLEDGE_DIR=            # default: the chart's charts/k8s-servant/knowledge folder
# TEAMS_WEBHOOK_URL_FILE=   # file with the webhook URL (used in the cluster); wins over TEAMS_WEBHOOK_URL
# MCP_TIMEOUT_SECONDS=60
# KUBECTL_PATH=kubectl
# KUBECTL_TIMEOUT_SECONDS=30
# MAX_ITERATIONS=25
# TOOL_OUTPUT_MAX_CHARS=8000
# FOUNDRY_TIMEOUT_SECONDS=120
# FOUNDRY_REASONING_EFFORT=medium
# EVENTS_EXCLUDE_REASONS=PolicyViolation
# ALERTS_IGNORE_NAMES=Watchdog,InfoInhibitor
# CHECK_SKIP_UNCHANGED=true
# CHECK_FULL_INTERVAL_HOURS=6
# PROMETHEUS_TIMEOUT_SECONDS=30
# NOTES_MAX_CHARS=8000
# CHECK_INTERVAL_MINUTES=60
# JOB_TIMEOUT_MINUTES=30
# MORNING_REPORT_ENABLED=true
# MORNING_REPORT_TIME=08:00
# MORNING_REPORT_TIMEZONE=UTC
# MORNING_REPORT_WEEKDAYS_ONLY=true
# HEARTBEAT_FILE=
# LOG_LEVEL=INFO
