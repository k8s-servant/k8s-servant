# Keep the build context small and free of local state and credentials. The image
# needs only pyproject.toml, README.md and the k8s_servant package.

# Local settings and memory (may hold endpoints, findings, notes)
.env
.data

# Version control, virtual environments, caches
.git
.venv
venv
__pycache__
*.pyc
*.egg-info
.pytest_cache
.superpowers
.claude

# Not needed at runtime: the chart delivers knowledge, CI runs the tests
tests
docs
tasks
examples
charts
.github
scripts
deploy

# Editor and OS files
.vscode
.idea
.DS_Store
*.log

# Docker files themselves
Dockerfile
.dockerignore
